<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash icon: green chat bubble (the brand mark, simplified to a single flat shape
    for the system splash). Foreground content stays inside the inner 2/3 to survive
    Android 12+ trim. Solid colors only — no gradients (cleanest at the small size
    the system splash renders at). Three cream dots inside echo the typing/chat hint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Chat bubble body — rounded square with bottom-left tail (matches BrandMark) -->
    <path
        android:fillColor="#2FB68C"
        android:pathData="M30,24 L78,24 A6,6 0 0 1 84,30 L84,72 A6,6 0 0 1 78,78 L38,78 L28,88 L30,78 A6,6 0 0 1 24,72 L24,30 A6,6 0 0 1 30,24 Z" />

    <!-- Three cream message dots inside the bubble -->
    <path
        android:fillColor="#F1EDDD"
        android:pathData="M42,51 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
    <path
        android:fillColor="#F1EDDD"
        android:pathData="M54,51 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
    <path
        android:fillColor="#F1EDDD"
        android:pathData="M66,51 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
</vector>
