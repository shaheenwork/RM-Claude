<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StrangerChat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
    </style>


    <style name="Theme.RandomChat.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/brandmark</item>

        <item name="windowSplashScreenIconBackgroundColor">
            @android:color/transparent
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.StrangerChat
        </item>
    </style>


</resources>
